{
  "name": "deltax-blackout",
  "version": "0.1.0",
  "private": true,
  "description": "Incident recovery lab \u2014 M1 deterministic core",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "demo": "tsc && node dist/src/cli.js",
    "demo:queue-storm": "tsc && node dist/src/cli.js --scenario queue-storm --seed 42",
    "demo:db-pressure": "tsc && node dist/src/cli.js --scenario database-pressure --seed 99",
    "test": "tsc && node --test dist/tests/unit.test.js dist/tests/invariants.test.js",
    "test:invariants": "tsc && node --test dist/tests/invariants.test.js",
    "test:unit": "tsc && node --test dist/tests/unit.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
